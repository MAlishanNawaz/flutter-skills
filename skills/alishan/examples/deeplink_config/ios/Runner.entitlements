<?xml version="1.0" encoding="UTF-8"?>
<!-- ios/Runner/Runner.entitlements (Associated Domains capability). Not Info.plist: there the key
     does nothing. Use applinks:example.com?mode=developer while developing; Apple's CDN caches AASA. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:example.com</string>
  </array>
</dict>
</plist>
